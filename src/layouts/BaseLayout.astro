---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Head from '../components/Head.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}
const { title, description, path } = Astro.props;

const nav = [
  { href: '/scrub', label: 'Scrub', hideOnMobile: false },
  { href: '/edit', label: 'Edit', hideOnMobile: false },
  { href: '/blog', label: 'Blog', hideOnMobile: false },
  { href: '/#how', label: 'How it works', hideOnMobile: true },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} path={path} />
    <script is:inline>
      // Set theme before paint to avoid a flash. Saved choice wins; else system.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          var light = t ? t === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches;
          if (light) document.documentElement.classList.add('light');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <header class="sticky top-0 z-50 border-b border-border/80 bg-bg/80 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
        <a href="/" class="group flex items-center gap-2.5 font-mono text-sm font-semibold tracking-tight">
          <span class="grid h-6 w-6 place-items-center rounded-sm bg-accent text-bg">▮</span>
          <span class="text-fg">meta<span class="text-accent">scrub</span></span>
        </a>
        <nav class="flex items-center gap-1 font-mono text-[13px]">
          {nav.map((n) => (
            <a
              href={n.href}
              class:list={[
                'rounded-md px-3 py-1.5 text-muted transition-colors hover:text-fg hover:bg-surface',
                current === n.href && 'text-fg',
                n.hideOnMobile && 'hidden sm:block',
              ]}
            >{n.label}</a>
          ))}
          <a
            href="https://github.com/MujahidAbbas"
            target="_blank"
            rel="noopener"
            class="ml-2 rounded-md border border-border px-3 py-1.5 text-muted transition-colors hover:border-border-bright hover:text-fg"
          >GitHub ↗</a>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle light and dark mode"
            class="ml-1 grid h-8 w-8 place-items-center rounded-md border border-border text-muted transition-colors hover:border-border-bright hover:text-fg"
          >
            <svg class="theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="theme-icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-12 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
          <div class="font-mono text-sm font-semibold">meta<span class="text-accent">scrub</span></div>
          <p class="max-w-sm text-sm text-muted">
            Your files never leave your device. Every PDF is processed locally in your browser —
            there is no server to upload to.
          </p>
        </div>
        <div class="flex flex-col gap-2 font-mono text-[13px] text-muted sm:items-end">
          <span class="text-faint">built by <a href="https://mujahidabbas.dev/" target="_blank" rel="noopener" class="text-fg hover:text-accent">Mujahid Abbas</a></span>
          <div class="flex gap-4">
            <a href="https://ko-fi.com/mujahiddev" target="_blank" rel="noopener" class="hover:text-accent">Buy me a coffee ☕</a>
            <a href="https://github.com/MujahidAbbas" target="_blank" rel="noopener" class="hover:text-accent">GitHub</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var light = document.documentElement.classList.toggle('light');
          try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
