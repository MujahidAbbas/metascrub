---
import BaseLayout from '../layouts/BaseLayout.astro';

const hidden = [
  { k: 'Author', v: 'j.doe@company.com', note: 'Your real name & email' },
  { k: 'Producer', v: 'Microsoft® Word 2021', note: 'The exact software you used' },
  { k: 'Created', v: '2024-01-15 09:42:11', note: 'When you really wrote it' },
  { k: 'Company', v: 'Acme Holdings Inc.', note: 'Org baked into the template' },
];

const steps = [
  { n: '01', t: 'Drop a PDF', d: 'Drag a file in — or several. It loads straight into your browser tab.' },
  { n: '02', t: 'Inspect', d: 'See every Info-dictionary and XMP field hiding inside, laid bare.' },
  { n: '03', t: 'Edit or scrub', d: 'Rewrite fields, or wipe the lot with one click. Watch what gets removed.' },
  { n: '04', t: 'Download', d: 'Save the clean copy. Nothing was ever uploaded anywhere.' },
];
---
<BaseLayout path="/">
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-grid"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 h-80 w-[42rem] -translate-x-1/2 rounded-full bg-accent/10 blur-[120px]"></div>

    <div class="mx-auto grid max-w-6xl gap-14 px-5 pt-20 pb-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:pt-28">
      <div>
        <div class="rise inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-3 py-1 font-mono text-xs text-muted" style="animation-delay:.05s">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          100% client-side · no uploads · no tracking
        </div>

        <h1 class="rise mt-6 text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl" style="animation-delay:.12s">
          Strip the secrets<br />out of your
          <span class="relative whitespace-nowrap text-accent">PDFs<span class="absolute -bottom-1 left-0 h-px w-full bg-accent/40"></span></span>.
        </h1>

        <p class="rise mt-6 max-w-md text-lg leading-relaxed text-muted" style="animation-delay:.2s">
          Every PDF carries hidden metadata — your name, your software, your timestamps.
          <span class="text-fg">MetaScrub</span> edits or erases it entirely, right in your browser.
          The file never touches a server.
        </p>

        <div class="rise mt-8 flex flex-wrap items-center gap-3" style="animation-delay:.28s">
          <a href="/scrub" class="group inline-flex items-center gap-2 rounded-md bg-redact px-5 py-3 font-mono text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">
            ▮ Scrub a PDF
          </a>
          <a href="/edit" class="inline-flex items-center gap-2 rounded-md border border-border-bright bg-surface px-5 py-3 font-mono text-sm font-semibold text-fg transition-colors hover:border-accent hover:text-accent">
            Edit metadata →
          </a>
        </div>

        <div class="rise mt-7 flex items-center gap-5 font-mono text-xs text-faint" style="animation-delay:.36s">
          <span>Info dict</span><span class="text-border-bright">/</span>
          <span>XMP packets</span><span class="text-border-bright">/</span>
          <span>Batch</span><span class="text-border-bright">/</span>
          <span>Open source</span>
        </div>
      </div>

      <!-- Inspector card: the signature redaction motif -->
      <div class="rise" style="animation-delay:.24s">
        <div class="overflow-hidden rounded-xl border border-border bg-surface shadow-2xl shadow-black/40">
          <div class="flex items-center gap-2 border-b border-border bg-surface-2 px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-redact/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-accent/40"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-border-bright"></span>
            <span class="ml-2 font-mono text-xs text-muted">resume_final.pdf — properties</span>
          </div>
          <div class="space-y-px bg-border/60 font-mono text-sm">
            {hidden.map((row, i) => (
              <div class="flex items-center justify-between gap-4 bg-surface px-4 py-3">
                <span class="text-faint">{row.k}</span>
                <span class="redact text-muted" style={`animation-delay:${0.9 + i * 0.18}s`}>{row.v}</span>
              </div>
            ))}
          </div>
          <div class="flex items-center justify-between border-t border-border bg-surface-2 px-4 py-3 font-mono text-xs">
            <span class="text-muted caret">metadata wiped</span>
            <span class="text-accent">4 fields removed</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S HIDING -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="flex items-end justify-between gap-6 border-b border-border pb-5">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">What's hiding in your PDF</h2>
      <span class="hidden font-mono text-xs text-faint sm:block">most people never check</span>
    </div>
    <div class="mt-8 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
      {hidden.map((row) => (
        <div class="group bg-surface p-6 transition-colors hover:bg-surface-2">
          <div class="font-mono text-xs uppercase tracking-wider text-accent">{row.k}</div>
          <div class="mt-3 font-mono text-sm text-fg">{row.v}</div>
          <p class="mt-2 text-sm text-muted">{row.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">How it works</h2>
    <p class="mt-2 max-w-lg text-muted">Four steps, zero accounts, nothing leaves your machine.</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <div class="relative rounded-xl border border-border bg-surface p-6">
          <div class="font-mono text-3xl font-semibold text-border-bright">{s.n}</div>
          <h3 class="mt-4 font-semibold text-fg">{s.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="relative overflow-hidden rounded-2xl border border-border bg-surface p-8 sm:p-12">
      <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-accent/10 blur-[100px]"></div>
      <div class="relative max-w-2xl">
        <div class="font-mono text-xs uppercase tracking-wider text-accent">The whole point</div>
        <h2 class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">
          There is no server. So there's nothing to leak.
        </h2>
        <p class="mt-4 leading-relaxed text-muted">
          Online PDF tools upload your document to their servers to process it — even the
          private ones. MetaScrub doesn't. The entire engine runs in your browser tab, so your
          confidential PDF stays on your device from the moment you drop it to the moment you
          download the clean copy. Even the fonts are self-hosted: this page makes
          <span class="text-fg">zero third-party network calls</span>.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/scrub" class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 font-mono text-sm font-semibold text-bg transition-transform hover:-translate-y-0.5">
            Try it — drop a PDF →
          </a>
          <span class="inline-flex items-center gap-2 font-mono text-xs text-faint">
            works offline · no signup
          </span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
