---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title="Blog — PDF metadata & privacy | MetaScrub"
  description="Guides on PDF metadata: what's hidden inside your files, how to remove it, and how to edit it — all without uploading anything."
  path="/blog"
>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-10">
    <div class="font-mono text-xs uppercase tracking-wider text-accent">Blog</div>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">PDF metadata, demystified</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">Short, practical guides on what's hiding in your PDFs and what to do about it.</p>

    <ul class="mt-12 space-y-px overflow-hidden rounded-xl border border-border bg-border">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block bg-surface p-6 transition-colors hover:bg-surface-2">
            <div class="font-mono text-xs text-faint">{fmt(post.data.pubDate)}</div>
            <h2 class="mt-2 text-lg font-semibold text-fg transition-colors group-hover:text-accent">{post.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
            <span class="mt-3 inline-block font-mono text-xs text-accent opacity-0 transition-opacity group-hover:opacity-100">read →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
